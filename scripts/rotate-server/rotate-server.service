[Unit]
Description=grok2api exit-IP rotation webhook (multi-instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 修改为实际部署路径与监听地址；默认 9000。
ExecStart=/usr/bin/python3 /opt/rotate-server/rotate-server.py --listen 0.0.0.0:9000
Restart=always
RestartSec=3
# docker 场景需要 docker 组权限（或改为 sudo 白名单）；
# 沙箱硬化:网络暴露的 webhook 服务即便被突破也尽量少拿到宿主能力。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# systemd 场景重启 unit 需要 root：
User=root

[Install]
WantedBy=multi-user.target
